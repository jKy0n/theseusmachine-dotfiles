{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "chafa",
        "source": "/home/jkyon/Pictures/GentooMedias/theseusmachine-proto-logo.png",
        "width":  40,
        "height": 15,
        "padding": {
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "    ",
        "color": "white"
    },

    "modules": [
        {
            "type": "custom", // Software
            "format": "────────────────────────── \u001b[1m Software \u001b[0m ─────────────────────────", // `\u001b` is `\033`, or `\e`
            "key": " "
        },
        {
            "type": "os",
            "key": "  " // Just get your distro's logo off nerdfonts.com,
        },
        {
            "type": "kernel",
            "key": "  ",
            "format": "{1} {2}"
        },
        // {
        //     "type": "command",  // Shell and Tmux version
        //     "key": "  ",
        //     "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-zsh+zellij-version.sh"
        // },
        // {
        //     "type": "command",      // niri and Noctalia version
        //     "key": "  ",
        //     "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-niri+noctalia-version.sh"
        // },
        // {
        //     "type": "custom", // Theme
        //     "format": "─────────────────────────── \u001b[1m Theme \u001b[0m ───────────────────────────",
        //     "key": " "
        // },
        // {
        //     "type": "theme",
        //     "key": "  ",
        //     "format": "{2}"
        // },
        // {
        //     "type": "icons",
        //     "key": "  󰉋",
        //     "format": "{2}"
        // },
        // {
        //     "type": "terminalfont",
        //     "key": "  ",
        //     "format": "{1}"
        // },
        // {
        //     "type": "cursor",
        //     "key": "  󰇀"
        // },
        {
            "type": "custom", // Hardware
            "format": "────────────────────────── \u001b[1m Hardware \u001b[0m ─────────────────────────",
            "key": " "
        },
        {
            "type": "cpu",
            "key": "  "
        },
        {
            "type": "memory",
            "key": "  ",
            "format": "Corsair Vengeance RGB RT - 4x16 GB ({3}) @ 3200 MHz"
        },
        {
            "type": "gpu",
            "detectionMethod": "pci",
            "key": "  󰢮",
            "format": "{2}"
        },
        // {
        //     "type": "custom", // Peripheral
        //     "format": "───────────────────────── \u001b[1m Peripheral \u001b[0m ────────────────────────",
        //     "key": " "
        // },
        // {
        //     "type": "custom",
        //     "key": "  ",
        //     "format": "HyperX Alloy Origins Core + Gradiente keycaps"
        // },
        // {
        //     "type": "custom",
        //     "key": "  󰍽",
        //     "format": "Logitech G403 Hero + switch Kaihl GM 4.0"
        // },
        {
            "type": "custom", // Uptime
            "format": "─────────────────────────── \u001b[1m Uptime \u001b[0m ──────────────────────────",
            "key": " "
        },
        {
            "type": "command",
            "key": "  ",
            "text": "whoami"
        },
        {
            "type": "command",
            "key": "  󰪫",
            "text": "uname -n"
        },
        {
            "type": "host",
            "key": "  "
        },
        {
            "type": "packages",
            "key": "  "
        },
        {
            "type": "command",
            "key": "  ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  "
            //"keyColo│r": "magenta"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
