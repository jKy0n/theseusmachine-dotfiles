layout {
    gaps 8

    focus-ring {
        width 3
        active-color "#c6a0f6"     // Catppuccin Frappé — Mauve
        inactive-color "#626880"   // Catppuccin Frappé — Surface2
    }

    // center-focused-column "never"
}