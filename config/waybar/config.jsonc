 *        Updated:    2026-08-09
 *        Notes:
 */
[
  // ---------------------------------------------------------
  // ----------------  Waybar tela Principal  ----------------
  // ---------------------------------------------------------
  {
    "output": "DP-1",
    "name": "bar-dp1",
    "layer": "top",
    "position": "right",
    "module-margin": "1",
    //  --------------------  Modules  --------------------
    "modules-left": [
      // "image#niri-logo",
      "niri/workspaces",
      "custom/spotify_player",
      "custom/spotify"
    ],
    "modules-right": [
      "pulseaudio/slider#out",
      "custom/network",
      "custom/portage-updates",
      "group/sysinfo",
      "memory",
      "custom/gpu-monitor",
      "custom/psu-monitor",
      // "network",
      "tray",
      "custom/mako-dnd",
      "custom/ephedrine",
      "clock",
      "custom/power"
    ],
    //  --------------------  Top Bar  --------------------
    "image#niri-logo": {
      "path": "/home/jkyon/Pictures/icons/niri/niri-logo.svg",
      "size": 20,
      "tooltip": false
    },
    "niri/workspaces": {
      "disable-scroll": false,
      //     "all-outputs": true,
      "warp-on-scroll": true,
      // "format": "{name}: {icon}",
      "format": "{icon}",
      "format-icons": {
        //         "1": "",
        //         "2": "",
        //         "3": "",
        //         "4": "",
        //         "5": "",
        "urgent": "",
        "focused": "",
        "default": ""
      }
    },
    "custom/spotify": {
      "format": "{icon}",
      "format-icons": {
        "playing": "",
        "paused": ""
      },
      "escape": true,
      "return-type": "json",
      "max-length": 40,
      "restart-interval": 5,
      "on-click": "playerctl -p spotify play-pause",
      "on-click-right": "playerctl -p spotify next",
      "smooth-scrolling-threshold": 1,
      "on-scroll-up": "playerctl -p spotify next",
      "exec": "$HOME/.config/waybar/scripts/media-player.py spotify 2> /dev/null",
      "tooltip": true
    },
    "custom/spotify_player": {
      "format": "{icon}",
      "format-icons": {
        "playing": "",
        "paused": ""
      },
      "escape": true,
      "return-type": "json",
      "max-length": 40,
      "restart-interval": 5,
      "on-click": "playerctl -p spotify_player play-pause",
      "on-click-right": "playerctl -p spotify_player next",
      "smooth-scrolling-threshold": 1,
      "on-scroll-up": "playerctl -p spotify_player next",
      "exec": "$HOME/.config/waybar/scripts/media-player.py spotify_player 2> /dev/null",
      "tooltip": true
    },
    //  --------------------  Bottom Bar  ------------------
    "clock": {
      "justify": "center",
      "format": "{:%H:%M}",
      "tooltip-format": "<tt><span size='10000'>{calendar}</span></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "first-day-of-week": 1,
        "on-scroll": 1,
        "on-click": "mode",
        "format": {
          "months": "<span color='#8caaee'><b>{}</b></span>",
          "days": "<span color='#c6d0f5'><b>{}</b></span>",
          "today": "<span color='#e78284'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    "custom/portage-updates": {
      "exec": "/usr/local/bin/portage-updates-waybar.sh",
      "return-type": "json",
      "signal": 8,
      "hide-empty-text": true,
      "tooltip": true
    },
    "group/sysinfo": {
      "orientation": "vertical",
      "modules": [
        "cpu",
        "temperature"
      ]
    },
    "custom/network": {
      "exec": "~/.config/waybar/scripts/network-monitor.sh",
      "return-type": "json",
      "interval": 15,
      "justify": "center"
    },
    "cpu": {
      "justify": "center",
      "format": "<span size='large'></span>\n{usage}%",
      ""
      // "tooltip-format": "CPU\nUso: {usage}%\nFrequência média: {avg_frequency}GHz"
    },
    "temperature": {
      "critical-threshold": 75,
      "justify": "center",
      "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
      "format": "{temperatureC}°C",
      "tooltip": false,
      "tooltip-format": "Temperatura da CPU: {temperatureC}°C"
    },
    "memory": {
      "justify": "center",
      "format": "<span size='large'></span>\n{}%",
      "tooltip-format": "RAM: {percentage}%\n({used}GB / {total}GB)\n\nSwap: {swapPercentage}%\n({swapUsed}GB / {swapTotal}GB)"
    },
    "custom/gpu-monitor": {
      "justify": "center",
      "exec": "~/.config/waybar/scripts/gpu-monitor.sh",
      "return-type": "json",
      "interval": 2
    },
    "custom/psu-monitor": {
      "justify": "center",
      "exec": "~/.config/waybar/scripts/psu-monitor.sh",
      "return-type": "json",
      "interval": 2
    },
    "pulseaudio/slider#out": {
      "min": 0,
      "max": 100,
      "orientation": "vertical",
      "zero-on-mute": true,
      "unmute-on-volume-change": true
    },
    // "network": {
    //   "format-disconnected": "<span size='large'></span>",
    //   "format-ethernet": "<span size='large'></span>",
    //   "format-linked": "{ifname} (No IP) ",
    //   "interface": "br0",
    //   "interval": "2",
    //   "justify": "center",
    //   "tooltip-format": "{ifname}\n{bandwidthUpBytes}\n{bandwidthDownBytes}"
    // },
    "tray": {
      "spacing": 8
    },
    "custom/mako-dnd": {
      "exec": "~/.config/waybar/scripts/mako-dnd.sh",
      "interval": "once",
      "justify": "center",
      "on-click": "makoctl mode -t dnd && pkill -RTMIN+8 waybar",
      "return-type": "json",
      "signal": 8,
      "tooltip": false
    },
    "custom/ephedrine": {
      "justify": "center",
      "exec": "~/.config/waybar/scripts/ephedrine.sh",
      "tooltip": true,
      "on-click": "ephedrine toggle && pkill -RTMIN+9 waybar",
      "return-type": "json",
      "interval": 10,
      "signal": 9
    },
    "custom/power": {
      "justify": "center",
      "format": "⏻",
      // "tooltip-format": "Menu de energia — clique pra abrir",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/scripts/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  },
  // ---------------------------------------------------------
  // --------------------  Waybar tela 1  --------------------
  // ---------------------------------------------------------
  {
    "output": "HDMI-A-1",
    "name": "bar-hdmi1",
    "layer": "top",
    "position": "top",
    "module-margin": 1,
    //  --------------------  Left Modules  --------------------
    "modules-left": [
      "niri/workspaces"
    ],
    "modules-center": [
      // "image#niri-logo",
      "clock"
    ],
    //  --------------------  Right Modules  --------------------
    "modules-right": [
      "custom/network",
      "cpu",
      "memory",
      "custom/power"
    ],
    "niri/workspaces": {
      "disable-scroll": false,
      //     "all-outputs": true,
      "warp-on-scroll": true,
      // "format": "{name}: {icon}",
      "format": "{icon}",
      "format-icons": {
        //         "1": "",
        //         "2": "",
        //         "3": "",
        //         "4": "",
        //         "5": "",
        "urgent": "",
        "focused": "",
        "default": ""
      }
    },
    "image#niri-logo": {
      "path": "/home/jkyon/Pictures/icons/niri/niri-logo.svg",
      "size": 25,
      "tooltip": false
    },
    "custom/network": {
      "exec": "~/.config/waybar/scripts/network-monitor.sh",
      "return-type": "json",
      "interval": 15,
      "justify": "center"
    },
    "cpu": {
      "justify": "center",
      "format": "<span size='large'> </span> {usage}%",
      // "tooltip-format": "CPU\nUso: {usage}%\nFrequência média: {avg_frequency}GHz"
    },
    "memory": {
      "justify": "center",
      "format": "<span size='large'> </span>{}%",
      "tooltip-format": "RAM: {percentage}%\n({used}GB / {total}GB)\n\nSwap: {swapPercentage}%\n({swapUsed}GB / {swapTotal}GB)"
    },
    "clock": {
      "justify": "center",
      "format": "{:%A, %d %B %Y - %R}",
      "tooltip-format": "<tt><span size='10000'>{calendar}</span></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "first-day-of-week": 1,
        "on-scroll": 1,
        "on-click": "mode",
        "format": {
          "months": "<span color='#8caaee'><b>{}</b></span>",
          "days": "<span color='#c6d0f5'><b>{}</b></span>",
          "today": "<span color='#e78284'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    "custom/power": {
      "justify": "center",
      "format": "<span size='14336'>⏻</span>",
      "tooltip": false,
      // "tooltip-format": "Menu de energia — clique pra abrir",
      "menu": "on-click",
      "menu-file": "~/.config/waybar/scripts/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  },
  // ---------------------------------------------------------
  // --------------------  Waybar tela 2  --------------------
  // ---------------------------------------------------------
