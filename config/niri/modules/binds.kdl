//
//        Title:      binds.kdl
//        Brief:
//        Path:       /home/jkyon/.config/niri/modules/binds.kdl
//        Author:     John Kennedy a.k.a. jKyon
//        Created:    2026-07-31
//        Updated:    2026-08-03
//        Notes:
//                    Baseado no bind set padrão do niri — mantido quase inteiro de propósito,
//                    pra você ir pegando o vocabulário de ações.
//                    Mod = Super por padrão numa sessão de verdade (TTY/SDDM).


binds {
    //  -----  Help menu  -----
    // Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+Slash { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }

    // -----  Quit  -----
    Mod+Shift+E { quit; }

    Mod+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Control+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn-sh "NO_MUX=1 kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Open a floating terminal (no mux)" { spawn "env" "NO_MUX=1" "kitty" "--class" "FloatingTerminal"; }

    //  -----  Apps do dia-a-dia  -----
    Mod+C hotkey-overlay-title="Open Calculator" { spawn "gnome-calculator"; }
    Mod+E hotkey-overlay-title="Open Dolphin" { spawn "dolphin"; }
    Mod+V hotkey-overlay-title="Open VS Code" { spawn "code"; }
    Mod+W hotkey-overlay-title="Open Firefox" { spawn "firefox"; }

    //  -----  Noctalia Launcher  -----
    Mod+P { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+O hotkey-overlay-title="Emoji picker" { spawn-sh "noctalia msg panel-toggle launcher /emo"; }

    //  -----  Walker - Launcher  -----
    // Mod+P hotkey-overlay-title="Run an Application: walker" { spawn-sh "nc -U \"$XDG_RUNTIME_DIR/walker/walker.sock\""; }
    // Mod+O hotkey-overlay-title="Emoji selector" { spawn "walker" "--provider" "symbols"; }

    //  -----  Manipulação de Workspace  -----
    // Mod+F2 hotkey-overlay-title="Rename current workspace" { spawn-sh "~/ShellScript/niri/rename-workspace.sh"; }
    // Mod+Shift+F2 hotkey-overlay-title="Unset workspace name" { spawn-sh "niri msg action unset-workspace-name"; }

    //  -----  Manipulação de Janelas -----
    // Alt+Tab { spawn-sh "noctalia msg window-switcher"; }

    //  -----  Niri  -----
     Mod+Shift+Semicolon { spawn-sh "noctalia msg settings-toggle"; }
     Mod+Shift+Period { spawn-sh "noctalia msg panel-toggle control-center"; }

    //  -----  Multimedia Keys -----
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    //  -----  Específico para o Spotify oficial  -----
    // XF86AudioPlay allow-when-locked=true { spawn-sh "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause"; }
    // XF86AudioStop allow-when-locked=true { spawn-sh "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause"; }
    // XF86AudioPrev allow-when-locked=true { spawn-sh "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous"; }
    // XF86AudioNext allow-when-locked=true { spawn-sh "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next"; }

    //  -----  Específico para o spotify_player  -----
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl --player=spotify_player,spotify play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl --player=spotify_player,spotify pause"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl --player=spotify_player,spotify previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl --player=spotify_player,spotify next"; }

    // --- Screenshot ---
    // Print hotkey-overlay-title="Take a screenshot and open in Satty" { spawn-sh "grim -t ppm - | satty --filename - --copy-command wl-copy --actions-on-enter=\"save-to-clipboard,exit\" --output-filename \"$HOME/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png\""; }
    // Mod+Shift+Print hotkey-overlay-title="Select area, take a screenshot and copy to clipboard" { spawn-sh "grim -g \"$(slurp -d)\" - | wl-copy"; }
    // Mod+Control+Print hotkey-overlay-title="Select area, take a screenshot and open in Satty" { spawn-sh "grim -t ppm -g \"$(slurp -d)\" - | satty --filename - --copy-command wl-copy --actions-on-enter=\"save-to-clipboard,exit\" --output-filename \"$HOME/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png\""; }
    Print hotkey-overlay-title="Take a window screenshot" { spawn-sh "noctalia msg screenshot-region"; }

    // Intercepta Ctrl + Scroll no Wayland e injeta a troca de abas no Firefox/Apps - Necessita de wtype
    Ctrl+WheelScrollDown { spawn "wtype" "-M" "ctrl" "-k" "Page_Down"; }
    Ctrl+WheelScrollUp   { spawn "wtype" "-M" "ctrl" "-k" "Page_Up"; }

    // --- Overview  ---
    Mod+Shift+O repeat=false { toggle-overview; }
    Mod+MouseMiddle repeat=false { toggle-overview; }

    // --- Fechar janela ---
    Mod+Q repeat=false { close-window; }

    // --- Navegação ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // --- Workspaces ---
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // --- Consumir/expelir da coluna ---
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // --- Larguras/alturas ---
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Shift+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // --- Floating (V virou o launcher do VSCode; ação original foi pra Ctrl+V) ---
    Mod+Ctrl+Space { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // --- Abas (W virou o launcher do Firefox; ação original foi pra Ctrl+W) ---
    Mod+Ctrl+W { toggle-column-tabbed-display; }
}
