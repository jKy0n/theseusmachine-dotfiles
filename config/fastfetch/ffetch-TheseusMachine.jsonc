{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "chafa",
        "source": "/home/jkyon/Pictures/GentooMedias/theseusmachine-proto-logo.png",
        "width":  60,
        "height": 25,
        "padding": {
            "top": 5,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "    ",
        "color": "white"
    },

    "modules": [
        {
            "type": "custom", // Software
            "format": "──────────────────────────────── \u001b[1m Software \u001b[0m ──────────────────────────────", // `\u001b` is `\033`, or `\e`
            "key": " "
        },
        {
            "type": "os",
            "key": "  " // Just get your distro logo off nerdfonts.com,
        },
        {
            "type": "kernel",
            "key": "  ",
            "format": "{1} {2}"
        },
        {
            "type": "command",  // Shell and Tmux version
            "key": "  ",
            "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-zsh+zellij-version.sh"
        },
        {
            "type": "editor",
            "key": "  ",
            "format": "{2} {5}"
        },
        {
            "type": "wm",
            "key": "  "
        },
        {
          "type": "command",
          "key": "  󰏒",
          "text": "noctalia --version | awk '{ print $1, $2 }'",
          "format": "{1}"
        },
        {
            "type": "command",
            "key": "  󰓃",
            "text": " pipewire --version | awk 'NR==1 {printf \"%s \", $1} NR==2 {print $4}' "
        },
        {
            "type": "command",      // Filesystem (BtrFS) and Bees version
            "key": "  ",
            "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-btrfs+bees-version.sh"  // << trocar isso aqui depois
        },
        {
            "type": "initsystem",
            "key": "  "
        },
        {
            "type": "command",
            "key": "  󱕵",
            "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-sudo+polkit-version.sh"
        },
        {
            "type": "command",      // GRUB and grub-btrfs version
            "key": "  󱫠",
            "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-grub+grub-btrfs-version.sh"
        },
        "break",
        {
            "type": "custom", // Theme
            "format": "───────────────────────────────── \u001b[1m Theme \u001b[0m ─────────────────────────────────",
            "key": " "
        },
        {
            "type": "theme",
            "key": "  ",
            "format": "{2}"
        },
        {
            "type": "icons",
            "key": "  󰉋",
            "format": "{2}"
        },
        {
            "type": "terminalfont",
            "key": "  ",
            "format": "{1}"
        },
        {
            "type": "cursor",
            "key": "  󰇀"
        },
        "break",
        {
            "type": "custom", // Hardware
            "format": "──────────────────────────────── \u001b[1m Hardware \u001b[0m ───────────────────────────────",
            "key": " "
        },
        {
            "type": "cpu",
            "key": "  "
        },
        {
            "type": "custom",
            "key": "  󰈐",
            "format": "Corsair iCue H150i RGB Pro XT (360mm)"
        },
        {
            "type": "memory",
            "key": "  ",
            "format": "Corsair Vengeance RGB RT - 4x16 GB ({3}) @ 3200 MHz"
        },
        {
            "type": "gpu",
            "detectionMethod": "pci",
            "key": "  󰢮",
            "format": "{2}"
        },
        {
            "type": "board",
            "key": "  󰚗",
            "format": "{2} - {1} - {3}"
        },
        {
            "type": "disk",
            "key": "  ",
            "percent": {},
            "format": "{20} - {3} - {9}"
        },
        "break",
        {
            "type": "custom", // Peripheral
            "format": "─────────────────────────────── \u001b[1m Peripheral \u001b[0m ──────────────────────────────",
            "key": " "
        },
        {
            "type": "custom",
            "key": "  ",
            "format": "HyperX Alloy Origins Core + Gradiente keycaps"
        },
        {
            "type": "custom",
            "key": "  󰃬",
            "format": "Exbom BK-N30"
        },
        {
            "type": "custom",
            "key": "  󰍽",
            "format": "Logitech G403 Hero + switch Kaihl GM 4.0"
        },
        {
            "type": "custom",
            "key": "  ",
            "format": "Wacom Intuos (CTL4100)"
        },
        {
            "type": "custom",
            "key": "  󰖠",
            "format": "Logitech C505"
        },
        {
            "type": "sound",
            "key": "  󰤽",
            "format": "{3}"
        },
        {
            "type": "custom",
            "key": "  ",
            "format": "Kuba Audio Uni (in ear)"
        },
        {
            "type": "custom",
            "key": "  ",
            "format": "Behringer B2 (@ Cardioide & Low Cut)"
        },
        {
            "type": "display",
            "key": "  󱄄",
            "format": "{6} - {1}x{2} @ {3}",
            "preciseRefreshRate": false
        },
        "break",
        {
            "type": "custom", // Uptime
            "format": "───────────────────────────────── \u001b[1m System \u001b[0m ────────────────────────────────",
            "key": " "
        },
        {
            "type": "command",
            "key": "  ",
            "text": "whoami"
        },
        {
            "type": "command",
            "key": "  󰪫",
            "text": "uname -n"
        },
        {
            "type": "packages",
            "key": "  "
        },
        {
            "type": "command",
            "key": "  ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  "
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "\u001b[1m \n              ________                              __  ___           __    _          \n             /_  __/ /_  ___  ________  __  _______/  |/  /___ ______/ /_  (_)___  ___  \n              / / / __ \\/ _ \\/ ___/ _ \\/ / / / ___/ /|_/ / __ `/ ___/ __ \\/ / __ \\/ _ \\ \n             / / / / / /  __(__  )  __/ /_/ (__  ) /  / / /_/ / /__/ / / / / / / /  __/ \n            /_/ /_/ /_/\\___/____/\\___/\\__,_/____/_/  /_/\\__,_/\\___/_/ /_/_/_/ /_/\\___/  \n                        \u001b[0m",
            "key": " "
        }
    ]
}
